# Copy this file to .env and use your own Razorpay test or live credentials.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
# Set to razorpay to enable Standard Checkout; use local_test only for local MVP testing.
PAYMENT_MODE=razorpay
# Set this before enabling production webhooks.
RAZORPAY_WEBHOOK_SECRET=replace_me

# Optional transactional receipts through Resend. Verify the sender domain in Resend first.
APP_URL=https://store.pi-coding.com
RESEND_API_KEY=re_replace_me
RECEIPT_FROM_EMAIL=NICHE store <receipts@pi-coding.com>
